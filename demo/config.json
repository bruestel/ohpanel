{
  "version": 1,
  "display": {
    "language": "en",
    "background": "aurora",
    "home_after": 300,
    "screen": {
      "brightness": 80,
      "idle_brightness": 40,
      "idle_after": 120,
      "night": {
        "from": "22:00",
        "to": "06:00"
      }
    },
    "date_format": "%a, %e %b"
  },
  "home": {
    "relays": [
      {
        "label": "Ceiling",
        "item": "Kitchen_Ceiling"
      },
      {
        "label": "Counter",
        "item": "Kitchen_Counter_Switch",
        "relay": false
      }
    ],
    "outdoor_temperature": {
      "item": "Weather_Temperature"
    },
    "outdoor_low": {
      "item": "Weather_Today_Min"
    },
    "outdoor_high": {
      "item": "Weather_Today_Max"
    },
    "weather_icon": {
      "item": "Weather_Icon",
      "codes": "openweathermap"
    },
    "weather_page": "weather",
    "values": [
      {
        "icon": "water-percent",
        "item": "Kitchen_Humidity",
        "decimals": 0
      },
      {
        "icon": "home-thermometer-outline",
        "item": "Kitchen_Temperature",
        "decimals": 1
      }
    ],
    "status_icons": [
      {
        "item": "Plants_Warning",
        "icon": "sprout",
        "color": "yellow"
      },
      {
        "item": "Window_Bath",
        "icon": "window-open-variant",
        "color": "red",
        "on": "OPEN"
      }
    ],
    "shortcuts": [
      {
        "item": "Speaker_State",
        "icon": [
          "ohpanel-equalizer-retro-1",
          "ohpanel-equalizer-retro-2",
          "ohpanel-equalizer-retro-3",
          "ohpanel-equalizer-retro-4",
          "ohpanel-equalizer-retro-5",
          "ohpanel-equalizer-retro-6",
          "ohpanel-equalizer-retro-7",
          "ohpanel-equalizer-retro-8"
