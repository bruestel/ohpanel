        "interval": 250,
        "color": "#e1a551",
        "open": "speaker",
        "on": "PLAYING"
      },
      {
        "item": "Washer_State",
        "icon": [
          "ohpanel-washer-1",
          "ohpanel-washer-2",
          "ohpanel-washer-3",
          "ohpanel-washer-4",
          "ohpanel-washer-5",
          "ohpanel-washer-6",
          "ohpanel-washer-7",
          "ohpanel-washer-8"
        ],
        "interval": 250,
        "color": "white",
        "open": "washer",
        "on": [
          "Run",
          "Pause",
          "Finished"
        ],
        "value_style": [
          {
            "equals": "Finished",
            "icon": "ohpanel-washer-1",
            "blink": 1000
          }
        ]
      },
      {
        "item": "Waste_Paper_Alarm",
        "icon": "delete",
        "color": "blue",
        "open": "waste"
      },
      {
        "item": "Waste_Organic_Alarm",
        "icon": "delete",
        "color": "brown",
        "open": "waste"
      }
